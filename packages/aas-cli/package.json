{
  "name": "@datadog/aas-cli",
  "version": "1.0.0",
  "description": "Datadog Azure App Service CLI tool",
  "repository": "https://github.com/DataDog/datadog-ci",
  "license": "Apache-2.0",
  "bin": "dist/cli.js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn clean; tsc",
    "build:win": "tsc",
    "clean": "rm -rf dist/*",
    "clean:win": "rm dist -r",
    "launch": "ts-node --transpile-only src/cli.ts",
    "launch:debug": "node -r ts-node/register/transpile-only --inspect-brk src/cli.ts",
    "lint": "yarn eslint || (echo \"\nYou can fix this by running ==> yarn format <==\n\" && false)",
    "eslint": "eslint --quiet 'src/**/*.ts'",
    "format": "yarn eslint --fix",
    "test": "jest --colors",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@azure/arm-appservice": "^16.0.0",
    "@azure/arm-resources": "^6.1.0",
    "@azure/identity": "^4.10.0",
    "axios": "^1.8.4",
    "chalk": "3.0.0",
    "clipanion": "^3.2.1",
    "datadog-metrics": "0.9.3",
    "fast-deep-equal": "^3.1.3",
    "js-yaml": "3.13.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.3",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^18.19.76",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "4.0.0",
    "jest": "29.6.2",
    "prettier": "2.0.5",
    "ts-jest": "29.1.1",
    "ts-node": "8.8.1",
    "typescript": "5.1.6"
  }
}
